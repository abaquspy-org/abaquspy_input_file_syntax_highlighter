{
  "scopeName": "source.abaqus",

  "patterns": [
    { "include": "#dollar_line" },
    { "include": "#keywords" },
    { "include": "#kv_pairs" },
    { "include": "#python_block" }
  ],

  "repository": {

    "keywords": {
      "patterns": [
        {
          "match": "^\\s*\\*\\*.*$",
          "name": "comment.line.abaqus"
        },
        {
          "match": "^\\s*\\*[^,\\r\\n]+",
          "name": "keyword.control.abaqus"
        },
        {
          "match": "\\$",
          "name": "punctuation.definition.dollar.abaqus"
        }
      ]
    },

    "dollar_line": {
      "begin": "^(\\s*\\$)\\s*",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.dollar.abaqus"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#dollar_output"
        }
      ]
    },

    "dollar_output": {
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "match": "\\*\\*.*$",
          "name": "comment.line.abaqus"
        },
        {
          "match": "\\*[^,\\r\\n]+",
          "name": "keyword.control.abaqus"
        },
        {
          "include": "#kv_pairs"
        }
      ]
    },

    "interpolation": {
      "name": "meta.embedded.inline.python.abaqus",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.python"
        }
      },
      "end": "\\}|(?=$)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.python"
        }
      },
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    },

    "kv_pairs": {
      "patterns": [
        {
          "begin": "(\\b[A-Z_]+(?:\\s+[A-Z_]+)*\\s*=)",
          "beginCaptures": {
            "1": {
              "name": "support.constant.parameter.abaqus"
            }
          },
          "end": "(?=,|$)",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "match": "[^{,\\n\\r]+",
              "name": "string.unquoted.value.abaqus"
            }
          ]
        },
        {
          "match": "(?<=,\\s*)(NLGEOM|ADD|REMOVE|FIXED|USER|FOLLOWER|FIELD|HISTORY|GENERATE|NONLINEAR|PRESSURE-OVERCLOSURE)(?=\\s*(?:,|$))",
          "captures": {
            "1": {
              "name": "string.unquoted.value.abaqus"
            }
          }
        }
      ]
    },

    "python_block": {
      "contentName": "meta.embedded.block.python.abaqus",

      "begin": "(<py\\b)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.tag.python.abaqus"
        }
      },

      "end": "(py>)",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag.python.abaqus"
        }
      },

      "patterns": [
        {
          "include": "#dollar_line"
        },
        {
          "match": "\\$",
          "name": "punctuation.definition.dollar.abaqus"
        },
        {
          "include": "source.python"
        }
      ]
    }
  }
}